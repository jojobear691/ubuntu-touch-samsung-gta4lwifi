From 4732ca3f39488090a9a5a373729986db065ece1d Mon Sep 17 00:00:00 2001
From: Jomama691 <245727092+jojobear691@users.noreply.github.com>
Date: Sat, 3 Oct 2026 14:08:36 -0600
Subject: [PATCH 1/3] gta4l-common: fix Halium 12 boot and product
 compatibility

---
 BoardConfigCommon.mk | 2 +-
 gta4l.mk             | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 846682b..a84b144 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -97,7 +97,7 @@ BOARD_KERNEL_OFFSET := 0x00008000
 BOARD_KERNEL_PAGESIZE := 4096
 BOARD_KERNEL_SEPARATED_DTBO := true
 BOARD_KERNEL_TAGS_OFFSET := 0x01E00000
-BOARD_RAMDISK_OFFSET := 0x020000000
+BOARD_RAMDISK_OFFSET := 0x02000000
 BOARD_DTB_OFFSET := 0x1F00000
 BOARD_MKBOOTIMG_ARGS := --kernel_offset $(BOARD_KERNEL_OFFSET) --ramdisk_offset $(BOARD_RAMDISK_OFFSET) --tags_offset $(BOARD_KERNEL_TAGS_OFFSET) --dtb_offset $(BOARD_DTB_OFFSET)
 BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
diff --git a/gta4l.mk b/gta4l.mk
index 302ec29..0b4e054 100644
--- a/gta4l.mk
+++ b/gta4l.mk
@@ -19,7 +19,9 @@ BOARD_API_LEVEL := 30
 BOARD_SHIPPING_API_LEVEL := 30
 PRODUCT_SHIPPING_API_LEVEL := 29
 
+ifneq ("$(wildcard $(SRC_TARGET_DIR)/product/non_ab_device.mk)","")
 $(call inherit-product, $(SRC_TARGET_DIR)/product/non_ab_device.mk)
+endif
 
 # Enable updating of APEXes
 $(call inherit-product, $(SRC_TARGET_DIR)/product/updatable_apex.mk)
